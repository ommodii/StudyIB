{
  "name": "ib-science-qbank",
  "version": "1.0.0",
  "description": "IB study app for sciences, mathematics, computer science, economics, and business management",
  "author": "Om Modi",
  "license": "ISC",
  "scripts": {
    "test": "node tests/test_gamification_ledger.js && node tests/test_account_progression.js && node tests/test_additional_subjects.js && node tests/test_expanded_topicals.js && node tests/test_worksheet_generator.js",
    "build:additional-subjects": "node scripts/build_additional_subjects.js",
    "upload:additional-subjects": "node scripts/upload_r2_manifest.js output/additional_subjects/web/upload_manifest.json 8",
    "build:topic-papers": "python -m scripts.topic_papers.cli --local-only",
    "build:question-production": "python -m scripts.topic_papers.production --subjects all --local-only",
    "build:question-web-data": "python -m scripts.topic_papers.build_web_dataset --version 2026-08-23-computer-science-v1 --corpus-root output/computer_science_release --base-js topic_question_data.js",
    "upload:question-web-data": "node scripts/upload_r2_manifest.js output/computer_science_release/web/upload_manifest.json 8",
    "build:web": "node build_web.js",
    "build:native": "npm run build:web",
    "deploy:worker": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@supabase/supabase-js": "2.111.0",
    "pdf-lib": "1.17.1"
  }
}
