{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://ommodi.site",
          "https://www.ommodi.site",
          "https://studyib.pages.dev",
          "http://localhost:8000"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "Range"
        ]
      },
      "exposeHeaders": [
        "Accept-Ranges",
        "Content-Length",
        "Content-Range",
        "ETag"
      ],
      "maxAgeSeconds": 86400
    }
  ]
}
